<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions track the transitive graph of TradingSystem.Functions (Worker SDK ->
         Microsoft.Extensions 10.x) — lower direct pins trip NU1605 downgrade errors. The old
         System.Text.Json 8.0.5 vulnerability pin is superseded by that same 10.x graph. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TradingSystem.Brokers.IBKR\TradingSystem.Brokers.IBKR.csproj" />
    <ProjectReference Include="..\..\src\TradingSystem.Core\TradingSystem.Core.csproj" />
    <ProjectReference Include="..\..\src\TradingSystem.Strategies\TradingSystem.Strategies.csproj" />
    <ProjectReference Include="..\..\src\TradingSystem.MarketData.Polygon\TradingSystem.MarketData.Polygon.csproj" />
    <!-- S4-007: inert readiness section (scorecard service + Discord daily report + inert ClaudeService) -->
    <ProjectReference Include="..\..\src\TradingSystem.AI\TradingSystem.AI.csproj" />
    <ProjectReference Include="..\..\src\TradingSystem.Functions\TradingSystem.Functions.csproj" />
  </ItemGroup>

</Project>
