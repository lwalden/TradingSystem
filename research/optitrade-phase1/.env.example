# OptiMind environment variables
# Copy this to .env and fill in your values. .env is gitignored.

# ── Mode ───────────────────────────────────────────────────────────────────────
# "paper" (default) or "live" — single control point for entire system
OPTIMIND_MODE=paper

# ── IB Gateway ────────────────────────────────────────────────────────────────
OPTIMIND_IB_HOST=127.0.0.1
OPTIMIND_IB_PAPER_PORT=4002
OPTIMIND_IB_LIVE_PORT=4001
OPTIMIND_IB_CLIENT_ID=1
OPTIMIND_IB_TIMEOUT=10.0

# ── Claude API ────────────────────────────────────────────────────────────────
OPTIMIND_ANTHROPIC_API_KEY=sk-ant-...
OPTIMIND_CLAUDE_MODEL=claude-sonnet-4-6

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development):
OPTIMIND_DATABASE_URL=sqlite+aiosqlite:///./data/optimind.db
# PostgreSQL (production):
# OPTIMIND_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/optimind

# ── Logging ───────────────────────────────────────────────────────────────────
OPTIMIND_LOG_LEVEL=INFO
OPTIMIND_LOG_JSON=false

# ── Capital ───────────────────────────────────────────────────────────────────
# Updated from IBKR on startup; used for risk % calculations
OPTIMIND_ACCOUNT_NLV=100000.0

# ── Feature flags ─────────────────────────────────────────────────────────────
OPTIMIND_AI_REGIME_ENABLED=true
OPTIMIND_GUIDED_MODE=true
